#!/usr/bin/env bash
# HashScope WebTrace v2.4.0 - Self-Contained Binary Bundle for macOS & Linux
# Developer: TOJO P THOMAS (Cyber Forensic Analyst | Investigator | Researcher)
set -e
RT_DIR="${TMPDIR:-/tmp}/.hashscope_webtrace_rt_v240"
if [ ! -f "$RT_DIR/server/index.cjs" ]; then
  rm -rf "$RT_DIR"
  mkdir -p "$RT_DIR"
  ARCHIVE_LINE=$(awk '/^__PAYLOAD_BELOW__/ {print NR + 1; exit 0; }' "$0")
  tail -n +$ARCHIVE_LINE "$0" | base64 -d > "$RT_DIR/payload.zip"
  unzip -q "$RT_DIR/payload.zip" -d "$RT_DIR"
  rm -f "$RT_DIR/payload.zip"
fi
cd "$RT_DIR"
node scripts/start-dev.cjs
exit 0
__PAYLOAD_BELOW__

